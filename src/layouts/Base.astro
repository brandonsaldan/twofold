---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/mark-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Twofold" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Twofold. Read the rest of your DNA test." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Twofold. Read the rest of your DNA test." />
    {structured.map(json => <script type="application/ld+json" set:html={json}></script>)}
    <script is:inline>try{var t=localStorage.getItem('twofold-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Twofold home">
          <svg class="brand-logo" viewBox="0 0 1078.037 217.346" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d={markPath} /><path fill="currentColor" d={wordPath} /></svg>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/support/" class="nav-support" aria-current={current('/support/')}>Support</a>
          <a href="/explore/" aria-current={current('/explore/')}>Explore</a>
          <a href="/get-data/" aria-current={current('/get-data/')}>Get your Data</a>
          <a href="/privacy/" class="nav-privacy" aria-current={current('/privacy/')}>Privacy</a>
          <a href="/about/" class="nav-about" aria-current={current('/about/')}>About</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">
            <svg class="theme-dot" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="8" /></svg>
          </button>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <div class="footer-main">
          <div class="footer-brand">
            <a class="brand" href="/" aria-label="Twofold home">
              <svg class="brand-logo" viewBox="0 0 1078.037 217.346" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d={markPath} /><path fill="currentColor" d={wordPath} /></svg>
            </a>
            <p class="footer-tagline">Read the rest of your DNA test.</p>
            <p class="credit">Built by <a href="https://brandonsaldan.com">Brandon Saldan</a>. Formerly GeneCodex.</p>
          </div>
          <nav class="footer-links" aria-label="Footer">
            <div>
              <p class="footer-heading">Use</p>
              <ul>
                <li><a href="/">Open your File</a></li>
                <li><a href="/explore/">Explore</a></li>
                <li><a href="/get-data/">Get your Data</a></li>
                <li><a href="/promethease-alternative/">Promethease Alternative</a></li>
              </ul>
            </div>
            <div>
              <p class="footer-heading">Project</p>
              <ul>
                <li><a href="/about/">About</a></li>
                <li><a href="/privacy/">Privacy</a></li>
                <li><a href="/support/">Support</a></li>
                <li><a href="https://github.com/brandonsaldan/twofold">GitHub</a></li>
              </ul>
            </div>
          </nav>
        </div>
        <p class="footer-legal">SNPedia content is shared under <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/us/">CC BY-NC-SA 3.0 US</a>. Twofold is not medical advice.</p>
      </footer>
    </div>
    <script>
      const toggle = document.getElementById('theme-toggle')
      const media = window.matchMedia('(prefers-color-scheme: dark)')
      const current = () => document.documentElement.dataset.theme || (media.matches ? 'dark' : 'light')
      const label = () => toggle?.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme')
      label()
      media.addEventListener('change', label)
      toggle?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = next
        try { localStorage.setItem('twofold-theme', next) } catch {}
        label()
      })
      if ('serviceWorker' in navigator && import.meta.env.PROD) window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js') })
    </script>
  </body>
</html>
